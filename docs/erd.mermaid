    LESSONS ||--o{ QUIZ_ATTEMPTS : attempted_via
    LESSONS ||--o{ EXERCISE_SUBMISSIONS : submitted_via

    ENROLLMENTS ||--o{ LESSON_PROGRESS : tracks

