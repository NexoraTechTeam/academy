    ENROLLMENTS ||--o| EXAM_REGISTRATIONS : "completes into (if training_completion)"
    EXAM_REGISTRATIONS ||--o{ EXAM_ATTEMPTS : "sat via"

    SYLLABUS_MODULES ||--o{ SYLLABUS_TOPICS : contains
    SYLLABUS_MODULES ||--o{ LESSONS : contains

