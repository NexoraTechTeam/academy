    USERS ||--o{ CERTIFICATES : holds
    USERS ||--o| MEMBERSHIPS : subscribes
    USERS ||--o| PORTFOLIO_SETTINGS : configures
    USERS ||--o{ STAFF_ASSIGNMENTS : "assigned as tutor/examiner"
    USERS ||--o{ PROFILE_VIEWS : "is viewed via"
    USERS ||--o{ REPORT_GENERATIONS : generates
    USERS }o--|| POSITIONS : "holds position"
    USERS ||--o{ AUDIT_LOG : "acts (actor)"
    USERS ||--o{ TRAINING_WAITLISTS : joins
    USERS ||--o{ UPSELL_IMPRESSIONS : "is shown"
    USERS ||--o{ COMPLIANCE_REMINDERS : receives
    USERS ||--o{ ORDERS : places
    COMPANIES ||--o{ ORDERS : "purchases (corporate)"
    ORDERS ||--o{ ORDER_ITEMS : contains
    TRAININGS ||--o{ ORDER_ITEMS : "sold via"
    USERS ||--o{ CATALOG_SEARCH_EVENTS : searches

    TRAININGS ||--o{ TRAINING_WAITLISTS : "queues for"
    CERTIFICATES ||--o{ CERTIFICATE_VERIFICATION_EVENTS : "looked up via"
    CERTIFICATES ||--o{ COMPLIANCE_REMINDERS : triggers
    VERIFIER_ACCOUNTS ||--o{ CERTIFICATE_VERIFICATION_EVENTS : "bulk verifies"

    POSITIONS ||--o{ POSITION_LEGACY_ALIASES : "maps legacy titles"

    COMPANIES ||--o{ SSO_CONNECTIONS : "configures SSO"
    COMPANIES ||--o{ AUDIT_LOG : "scoped in"

    COMPANIES ||--o{ USERS : employs
    COMPANIES ||--o| COMPANY_SEATS : purchases
    COMPANIES ||--o{ TRAININGS : "owns (internal only)"

    TRAININGS ||--o{ SYLLABUS_MODULES : contains
    TRAININGS ||--o{ ENROLLMENTS : "enrolled via"
    TRAININGS ||--o{ STAFF_ASSIGNMENTS : "assigned staff"
    TRAININGS ||--o{ CERTIFICATES : issues
    TRAININGS ||--o{ TRAINING_RELATED_TRAININGS : "curated as related to"
    TRAININGS }o--o| CERTIFICATION_SCHEMES : "prepares for (optional)"
    CERTIFICATES }o--o| CERTIFICATION_SCHEMES : "earned (optional)"
    CERTIFICATION_SCHEMES ||--o{ EXAM_EVENTS : "scheduled as"
    CERTIFICATION_SCHEMES ||--o{ ELIGIBILITY_VERIFICATIONS : gates
    CERTIFICATION_SCHEMES ||--o{ EXAM_REGISTRATIONS : "registered for"
    CERTIFICATION_SCHEMES ||--o{ QUESTION_BANKS : "owns (nullable — null = general bank)"
    CERTIFICATION_SCHEMES ||--o{ EXAM_DEFINITIONS : "defines exam for"
    QUESTION_BANKS ||--o{ QUESTIONS : contains
    EXAM_DEFINITIONS }o--o{ QUESTIONS : "references (fixed mode)"
    USERS ||--o{ ELIGIBILITY_VERIFICATIONS : submits
    USERS ||--o{ EXAM_REGISTRATIONS : registers
    EXAM_EVENTS ||--o{ EXAM_REGISTRATIONS : "booked via"
    ELIGIBILITY_VERIFICATIONS ||--o| EXAM_REGISTRATIONS : "unlocks (if direct_verified)"
    USERS ||--o{ ACCESS_REQUESTS : submits
    COMPANIES ||--o{ ACCESS_REQUESTS : "requested for (optional)"
    USERS ||--o{ ACCESS_REQUESTS : "decides (operator, optional)"
